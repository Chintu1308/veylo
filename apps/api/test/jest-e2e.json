{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/setup.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@veylo/shared$": "<rootDir>/../../../packages/shared/src/index.ts",
    "^@veylo/shared/(.*)$": "<rootDir>/../../../packages/shared/src/$1"
  },
  "globals": {
    "ts-jest": {
      "tsconfig": "./tsconfig.json"
    }
  }
}
